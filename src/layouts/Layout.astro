---
import '../styles/global.css';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: 'Smitam Dental Care',
  image: '/images/clinic-operatory.jpg',
  telephone: '+91-87660-36310',
  priceRange: '₹₹',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1st Floor, Shree Complex, 4th Lane, Rajarampuri',
    addressLocality: 'Kolhapur',
    addressRegion: 'Maharashtra',
    postalCode: '416008',
    addressCountry: 'IN',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '10:00', closes: '13:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '17:00', closes: '20:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '10:00', closes: '13:00' },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Concept demo: keep noindex until a real clinic signs off. Remove for a live client site. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>Smitam Dental Care — Dentist in Rajarampuri, Kolhapur</title>
    <meta name="description" content="Smitam Dental Care, Rajarampuri, Kolhapur. Check-ups, root canal treatment, braces and clear aligners, implants and kids' dentistry. Book your visit on WhatsApp." />
    <meta name="theme-color" content="#13294B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Smitam Dental Care — Rajarampuri, Kolhapur" />
    <meta property="og:description" content="Unhurried dental care for families. Written treatment plan and cost before we start. Book on WhatsApp." />
    <meta property="og:image" content="/og-image.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Tiro+Devanagari+Marathi&family=Urbanist:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href="/images/hero-consult.jpg" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />

    <script>
      // Scroll reveal
      const els = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -8% 0px' }
      );
      els.forEach((el) => io.observe(el));

      // Any element with data-book="Treatment name" pre-selects it in the
      // booking form and scrolls there (replaces React's lifted state).
      document.addEventListener('click', (e) => {
        const target = e.target instanceof Element ? e.target.closest('[data-book]') : null;
        if (!target) return;
        const name = target.getAttribute('data-book') || '';
        document.dispatchEvent(new CustomEvent('book:treatment', { detail: name }));
        document.getElementById('book')?.scrollIntoView({ behavior: 'smooth' });
      });
    </script>
  </body>
</html>
