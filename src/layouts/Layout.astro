---
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/ui/Header.astro';
import FloatingWhatsApp from '../components/ui/FloatingWhatsApp.astro';
import MobileActionBar from '../components/ui/MobileActionBar.astro';
import ReviewsBar from '../components/ui/ReviewsBar.astro';
import Footer from '../components/sections/Footer.astro';

const {
  title = 'Platinum Dental Care — Dentist in Nagala Park, Kolhapur',
  description = "Platinum Dental Care, Nagala Park, Kolhapur. Check-ups, root canals, dental implants, veneers & crowns, teeth whitening and children's dentistry. Book your visit on WhatsApp.",
  preloadImage,
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: 'Platinum Dental Care',
  image: '/images/clinic-operatory.jpg',
  telephone: '+91-97642-41177',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '3rd Floor, Krystal Square, 100 Ft Road, near Khanvilkar petrol pump, Nagala Park',
    addressLocality: 'Kolhapur',
    addressRegion: 'Maharashtra',
    postalCode: '416002',
    addressCountry: 'IN',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '10:00', closes: '22:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '10:00', closes: '20:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '10:00', closes: '14:00' },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#13294B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Platinum Dental Care — Nagala Park, Kolhapur" />
    <meta property="og:description" content="Unhurried dental care for families. Written treatment plan before we start. Book on WhatsApp." />
    <meta property="og:image" content="/og-image.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Tiro+Devanagari+Marathi&family=Urbanist:wght@500;600;700;800&display=swap" rel="stylesheet" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} />}

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:bg-white focus:px-4 focus:py-2">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ReviewsBar />
    <FloatingWhatsApp />
    <MobileActionBar />

    <script is:inline>
      // Bottom bars (reviews bar, mobile Call/WhatsApp/Directions) show only
      // after the visitor scrolls a little, and hide again back at the top.
      (function () {
        var root = document.documentElement;
        var update = function () { root.classList.toggle('is-scrolled', window.scrollY > 160); };
        update();
        window.addEventListener('scroll', update, { passive: true });
      })();
    </script>

    <script>
      // Scroll reveal
      const els = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -8% 0px' }
      );
      els.forEach((el) => io.observe(el));

      // Any element with data-book="Treatment name" pre-selects it in the
      // booking form. If the form is on this page, scroll to it; otherwise
      // go to the booking page with the treatment in the query string.
      document.addEventListener('click', (e) => {
        const target = e.target instanceof Element ? e.target.closest('[data-book]') : null;
        if (!target) return;
        const name = target.getAttribute('data-book') || '';
        const book = document.getElementById('book');
        if (book) {
          document.dispatchEvent(new CustomEvent('book:treatment', { detail: name }));
          book.scrollIntoView({ behavior: 'smooth' });
        } else {
          window.location.href = name ? `/book?treatment=${encodeURIComponent(name)}` : '/book';
        }
      });
    </script>
  </body>
</html>
