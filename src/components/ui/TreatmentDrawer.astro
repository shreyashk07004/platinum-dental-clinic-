---
import { X, Clock, HeartPulse, IndianRupee } from '@lucide/astro';
import { waLink, treatmentMessage } from '../../utils/whatsapp';
import WhatsAppIcon from './WhatsAppIcon.astro';

// One pre-rendered drawer per treatment, shown/hidden by the script in Treatments.astro.
const { treatment: t } = Astro.props;
const fmt = (n) => (n ? `from ₹${new Intl.NumberFormat('en-IN').format(n)}` : 'Ask for estimate');
---

<div id={`drawer-${t.id}`} data-drawer hidden>
  <div class="fixed inset-0 z-50 flex justify-end" role="dialog" aria-modal="true" aria-labelledby={`drawer-title-${t.id}`}>
    <button type="button" class="absolute inset-0 bg-ink-deep/50" data-drawer-close aria-label="Close" tabindex="-1"></button>
    <div class="relative flex h-full w-full max-w-[480px] flex-col overflow-y-auto bg-white">
      <div class="flex items-start justify-between gap-4 border-b border-line p-6 md:p-8">
        <div>
          <p class="kicker !mb-2">Treatment</p>
          <h3 id={`drawer-title-${t.id}`} class="text-[1.75rem] font-bold leading-tight">{t.name}</h3>
        </div>
        <button type="button" data-drawer-close data-autofocus class="rounded p-1.5 text-ink hover:bg-enamel" aria-label="Close details">
          <X class="h-6 w-6" />
        </button>
      </div>
      <div class="flex-1 space-y-6 p-6 md:p-8">
        <p class="text-[16.5px]">{t.detail}</p>
        <dl class="divide-y divide-line border-y border-line text-[15px]">
          <div class="flex gap-3 py-3.5">
            <Clock class="mt-0.5 h-5 w-5 shrink-0 text-clinic" />
            <dt class="sr-only">Visits</dt><dd>{t.visits}</dd>
          </div>
          <div class="flex gap-3 py-3.5">
            <HeartPulse class="mt-0.5 h-5 w-5 shrink-0 text-clinic" />
            <dt class="sr-only">Recovery</dt><dd>{t.recovery}</dd>
          </div>
          <div class="flex gap-3 py-3.5">
            <IndianRupee class="mt-0.5 h-5 w-5 shrink-0 text-clinic" />
            <dt class="sr-only">Cost</dt>
            <dd><span class="font-semibold text-ink">{fmt(t.from)}</span> — exact cost in writing after your check-up.</dd>
          </div>
        </dl>
        <p class="text-[14px] text-slate-soft"><span class="font-semibold text-ink">Usually helps with:</span> {t.fixes}.</p>
      </div>
      <div class="grid gap-2 border-t border-line p-6 md:p-8">
        <button type="button" data-drawer-close data-book={t.name} class="btn-primary w-full">Book a consultation for this</button>
        <a href={waLink(treatmentMessage(t.name))} target="_blank" rel="noopener noreferrer" class="btn-outline w-full">
          <WhatsAppIcon class="h-[18px] w-[18px]" /> Ask a question on WhatsApp
        </a>
      </div>
    </div>
  </div>
</div>
