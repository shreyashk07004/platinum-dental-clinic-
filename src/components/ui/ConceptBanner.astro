---
import { X } from '@lucide/astro';
import { site } from '../../data/site';
---

<aside id="concept-banner" aria-label="Concept website notice" class="bg-ink-deep text-white/85">
  <div class="wrap flex items-center justify-between gap-3 py-2 text-[12.5px]">
    <p class="leading-snug">
      <span class="mr-2 rounded-sm bg-clinic px-1.5 py-0.5 font-display text-[10.5px] font-bold uppercase tracking-wider text-ink-deep">
        Concept
      </span>
      Concept website by{' '}
      <a href={site.agencyUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-white underline decoration-clinic underline-offset-2">
        {site.agencyName}
      </a>{' '}
      — a sample of what your clinic’s site could look like. Clinic name and details are fictional.
    </p>
    <button type="button" data-dismiss-banner aria-label="Dismiss notice" class="shrink-0 rounded p-1 text-white/60 hover:bg-white/10 hover:text-white">
      <X class="h-4 w-4" />
    </button>
  </div>
</aside>

<script>
  document.querySelector('[data-dismiss-banner]')?.addEventListener('click', () => {
    document.getElementById('concept-banner')?.remove();
  });
</script>
