---
// Bar fixed to the bottom of the window (all pages):
//   Google · rating ★★★★★ · N Reviews · See All Reviews ›   [reviewer circles]   one review, sliding left to the next
// Visitors can close it with × (it comes back on the next page load). On phones it sits
// above the Call / WhatsApp / Directions bar. Reviews: src/data/reviews.js.
import { Star, ChevronRight, X } from '@lucide/astro';
import { google, reviews } from '../../data/reviews';

// Reviewer circles: their Google profile pictures (initials as a fallback).
const avatarColors = ['#5E97F6', '#F06292', '#26A69A', '#FFA726', '#9575CD', '#EF5350', '#66BB6A'];
const initial = (name: string) => name.trim().charAt(0).toUpperCase();
const faces = reviews.slice(0, 5);
const stars = Array.from({ length: 5 });
---

<div class="rb-spacer h-[60px] md:h-[84px]" aria-hidden="true"></div>

<aside
  id="reviews-bar"
  aria-label="Google reviews"
  class="rb fixed inset-x-0 bottom-[calc(62px+env(safe-area-inset-bottom))] z-30 bg-[#1D3A68] text-white md:bottom-0"
>
  <div class="relative mx-auto flex h-[60px] max-w-[1400px] items-center gap-3 pl-3 pr-9 sm:pl-5 md:h-[84px] md:gap-8 md:px-12 lg:px-16">
    <!-- Summary -->
    <a
      href={google.link}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex shrink-0 items-center gap-2.5 md:gap-6"
      aria-label={`Rated ${google.rating.toFixed(1)} out of 5 from ${google.count} Google reviews. See all reviews on Google`}
    >
      <!-- "G" icon on phones, full wordmark from tablet up -->
      <span class="grid h-8 w-8 place-items-center rounded-full bg-white md:hidden" aria-hidden="true">
        <svg viewBox="0 0 48 48" class="h-[18px] w-[18px]"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.2 0 24 0 14.6 0 6.6 5.4 2.6 13.3l7.9 6.1C12.4 13.7 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.2 5.3-4.6 6.9l7.4 5.7c4.3-4 6.9-9.9 6.9-17.1z"/><path fill="#FBBC05" d="M10.5 28.6c-.5-1.4-.8-3-.8-4.6s.3-3.2.8-4.6l-7.9-6.1C.9 16.6 0 20.2 0 24s.9 7.4 2.6 10.7l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.8-5.8l-7.4-5.7c-2.1 1.4-4.8 2.3-8.4 2.3-6.3 0-11.6-4.2-13.5-9.9l-7.9 6.1C6.6 42.6 14.6 48 24 48z"/></svg>
      </span>
      <span class="rb-wordmark hidden md:inline" aria-hidden="true">
        <span style="color:#4285F4">G</span><span style="color:#EA4335">o</span><span style="color:#FBBC05">o</span><span style="color:#4285F4">g</span><span style="color:#34A853">l</span><span style="color:#EA4335">e</span>
      </span>

      <span class="flex flex-col leading-none md:flex-row md:items-center md:gap-7" aria-hidden="true">
        <span class="flex items-center gap-1.5">
          <span class="font-display text-[16px] font-medium md:text-[19px]">{google.rating.toFixed(1)}</span>
          <span class="flex text-[#F7B500]">
            {stars.map(() => <Star class="h-3 w-3 fill-current md:h-[17px] md:w-[17px]" strokeWidth={1.5} />)}
          </span>
        </span>
        <span class="mt-1 text-[12px] text-white/75 md:mt-0 md:text-[19px] md:text-white">{google.count} Reviews</span>
        <span class="hidden items-center gap-1 text-[19px] group-hover:underline lg:inline-flex">
          See All Reviews <ChevronRight class="h-5 w-5" />
        </span>
      </span>
    </a>

    <!-- Reviewer circles -->
    <div class="ml-auto hidden shrink-0 xl:flex" aria-hidden="true">
      {
        faces.map((r, i) => (
          <span
            class="-ml-3 grid h-12 w-12 place-items-center overflow-hidden rounded-full border-2 border-[#1D3A68] font-display text-[18px] font-semibold text-white first:ml-0"
            style={`background:${avatarColors[i % avatarColors.length]}; z-index:${10 - i}`}
          >
            {r.photo ? (
              <img src={r.photo} alt="" width="48" height="48" loading="lazy" class="h-full w-full object-cover" referrerpolicy="no-referrer" />
            ) : (
              initial(r.name)
            )}
          </span>
        ))
      }
    </div>

    <!-- One review at a time, sliding left -->
    <div class="rb-viewport relative h-full min-w-0 flex-1 overflow-hidden md:ml-auto md:max-w-[500px] xl:ml-10" data-rb-viewport>
      <ul class="rb-track flex h-full" data-rb-track aria-live="off">
        {
          [...reviews, reviews[0]].map((r, i) => (
            <li class="flex h-full w-full shrink-0 flex-col justify-center" aria-hidden={i === reviews.length ? 'true' : undefined}>
              <p class="rb-text text-[12.5px] leading-[1.35] md:text-[15.5px]">{r.text}</p>
              <p class="mt-0.5 font-display text-[12.5px] font-bold md:text-[15.5px]">- {r.name}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <button
      type="button"
      class="absolute right-1.5 top-1/2 grid h-7 w-7 -translate-y-1/2 place-items-center rounded-full text-white/60 transition-colors hover:bg-white/10 hover:text-white md:right-3"
      aria-label="Hide reviews bar"
      data-rb-close
    >
      <X class="h-4 w-4" />
    </button>
  </div>
</aside>

<style>
  .rb { animation: rb-in 500ms ease 600ms both; box-shadow: 0 -4px 18px rgba(13, 30, 56, 0.18); }
  @keyframes rb-in { from { transform: translateY(100%); } to { transform: none; } }

  .rb-wordmark {
    font-family: 'Product Sans', 'Google Sans', Urbanist, system-ui, sans-serif;
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .rb-track { transition: transform 700ms cubic-bezier(0.65, 0, 0.35, 1); }
  .rb-track.no-anim { transition: none; }

  .rb-text {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .rb { animation: none; }
    .rb-track { transition: none; }
  }

  /* Closed by the visitor */
  :global(html.rb-closed) .rb,
  :global(html.rb-closed) .rb-spacer { display: none; }

  /* Lift the desktop WhatsApp button above the bar while it's showing */
  @media (min-width: 768px) {
    :global(html:not(.rb-closed) [data-float-wa]) { bottom: 104px; }
  }
</style>

<script>
  const html = document.documentElement;
  document.querySelector('[data-rb-close]')?.addEventListener('click', () => {
    html.classList.add('rb-closed');
  });

  // Slide to the next review every few seconds. The last slide is a copy of
  // the first, so after it we jump back to the start without animation.
  const viewport = document.querySelector<HTMLElement>('[data-rb-viewport]');
  const track = document.querySelector<HTMLElement>('[data-rb-track]');
  if (viewport && track) {
    const total = track.children.length - 1;
    let index = 0;
    let paused = false;

    const go = (i: number, animate = true) => {
      track.classList.toggle('no-anim', !animate);
      index = i;
      track.style.transform = `translateX(-${index * 100}%)`;
    };

    track.addEventListener('transitionend', () => {
      if (index === total) go(0, false);
    });

    viewport.addEventListener('mouseenter', () => (paused = true));
    viewport.addEventListener('mouseleave', () => (paused = false));

    window.setInterval(() => {
      if (paused || document.hidden || html.classList.contains('rb-closed')) return;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) go((index + 1) % total, false);
      else go(index + 1);
    }, 5000);
  }
</script>
