---
import { Phone, CircleCheck } from '@lucide/astro';
import { site } from '../../data/site';
import { doctors } from '../../data/doctors';
import { treatments } from '../../data/treatments';
import { clinicHours } from '../../data/hours';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';

const errClass = 'mt-1 text-[13px] font-medium text-[#B23A2B]';
---

<section id="book" aria-labelledby="book-title" class="bg-enamel py-20 md:py-28">
  <div class="wrap grid gap-12 lg:grid-cols-12">
    <div class="reveal lg:col-span-4">
      <p class="kicker">Book a visit</p>
      <h2 id="book-title" class="h-section">Pick a time. We’ll confirm on WhatsApp.</h2>
      <p class="mt-5 text-[16.5px]">
        Fill this in and WhatsApp opens with your request already written. Press send — we reply during OPD
        hours to confirm, or suggest the nearest free slot.
      </p>
      <div class="mt-8 border-t border-line pt-6 text-[15px]">
        <p class="font-semibold text-ink">Prefer to call?</p>
        <a href={`tel:${site.phoneRaw}`} class="mt-1 inline-flex items-center gap-2 font-display text-[22px] font-bold text-action hover:underline">
          <Phone class="h-5 w-5" /> {site.phoneDisplay}
        </a>
        <p class="mt-3 text-slate-soft">{clinicHours.emergencyNote}</p>
      </div>
    </div>

    <form id="booking-form" novalidate class="reveal rounded-md border border-line bg-white p-6 md:p-9 lg:col-span-8">
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="b-name" class="label">Full name</label>
          <input id="b-name" name="name" class="field" autocomplete="name" aria-invalid="false" />
          <p id="name-err" class={errClass} hidden></p>
        </div>
        <div>
          <label for="b-phone" class="label">Mobile number</label>
          <input id="b-phone" name="phone" class="field" inputmode="tel" autocomplete="tel" placeholder="98xxxxxxxx" aria-invalid="false" />
          <p id="phone-err" class={errClass} hidden></p>
        </div>
        <div>
          <label for="b-treat" class="label">Reason for visit</label>
          <select id="b-treat" name="treatment" class="field">
            {treatments.map((t) => <option selected={t.name === 'Check-up & consultation'}>{t.name}</option>)}
            <option>Pain / emergency</option>
            <option>Not sure — need a check-up</option>
          </select>
        </div>
        <div>
          <label for="b-doc" class="label">Doctor</label>
          <select id="b-doc" name="doctor" class="field">
            <option selected>Any available doctor</option>
            {doctors.map((d) => <option>{d.name}</option>)}
          </select>
        </div>
        <div>
          <label for="b-date" class="label">Preferred date</label>
          <input id="b-date" name="date" type="date" class="field" aria-invalid="false" />
          <p id="date-err" class={errClass} hidden></p>
        </div>
        <div>
          <label for="b-slot" class="label">Preferred time</label>
          <select id="b-slot" name="slot" class="field" disabled aria-invalid="false">
            <option value="">Choose a date first</option>
          </select>
          <p id="slot-err" class={errClass} hidden></p>
        </div>
        <div class="sm:col-span-2">
          <label for="b-note" class="label">Anything we should know? <span class="font-normal text-slate-soft">(optional)</span></label>
          <textarea id="b-note" name="note" rows="3" class="field resize-y" placeholder="e.g. pain in lower left tooth since 3 days"></textarea>
        </div>
        <label class="flex items-center gap-3 text-[15px] text-ink sm:col-span-2">
          <input type="checkbox" name="firstVisit" checked class="h-4 w-4 accent-action" />
          This is my first visit to the clinic
        </label>
      </div>

      <div class="mt-7 flex flex-col gap-4 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-[13px] text-slate-soft">Your details go only to the clinic’s WhatsApp. Nothing is stored on this website.</p>
        <button type="submit" class="btn-primary shrink-0">
          <WhatsAppIcon class="h-[18px] w-[18px]" /> Send request on WhatsApp
        </button>
      </div>
      <div id="booking-sent" hidden>
        <p role="status" class="mt-5 flex items-start gap-2 rounded bg-clinic-light p-3.5 text-[14.5px] text-ink">
          <CircleCheck class="mt-0.5 h-5 w-5 shrink-0 text-action" />
          WhatsApp should have opened with your request — just press send. If it didn’t open, call us on {site.phoneDisplay}.
        </p>
      </div>
    </form>
  </div>
</section>

<script>
  import { slotsFor, todayISO } from '../../utils/hours';
  import { waLink, bookingMessage } from '../../utils/whatsapp';

  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  if (form) {
    const field = <T extends HTMLElement>(name: string) => form.elements.namedItem(name) as T;
    const name = field<HTMLInputElement>('name');
    const phone = field<HTMLInputElement>('phone');
    const treatment = field<HTMLSelectElement>('treatment');
    const doctor = field<HTMLSelectElement>('doctor');
    const date = field<HTMLInputElement>('date');
    const slot = field<HTMLSelectElement>('slot');
    const note = field<HTMLTextAreaElement>('note');
    const firstVisit = field<HTMLInputElement>('firstVisit');
    const sent = document.getElementById('booking-sent');
    const inputs: Record<string, HTMLElement> = { name, phone, date, slot };

    // Date limits come from the visitor's "today" in clinic time, not build time.
    date.min = todayISO();
    date.max = todayISO(60);

    let slots: string[] = [];
    const renderSlots = () => {
      slots = slotsFor(date.value);
      const placeholder = !date.value ? 'Choose a date first' : slots.length ? 'Select a time' : 'No slots on this day';
      slot.replaceChildren(new Option(placeholder, ''), ...slots.map((s) => new Option(s, s)));
      slot.value = '';
      slot.disabled = !date.value || !slots.length;
    };

    const setError = (k: string, msg?: string) => {
      const input = inputs[k];
      const p = document.getElementById(`${k}-err`);
      if (!input || !p) return;
      p.textContent = msg || '';
      p.hidden = !msg;
      input.setAttribute('aria-invalid', String(!!msg));
      if (msg) input.setAttribute('aria-describedby', `${k}-err`);
      else input.removeAttribute('aria-describedby');
    };

    Object.keys(inputs).forEach((k) => {
      const ev = inputs[k] instanceof HTMLSelectElement || k === 'date' ? 'change' : 'input';
      inputs[k].addEventListener(ev, () => setError(k));
    });
    date.addEventListener('change', renderSlots);

    // Pre-select a treatment chosen elsewhere on the page (finder, treatment drawer).
    document.addEventListener('book:treatment', (e) => {
      const value = (e as CustomEvent<string>).detail;
      if (value) treatment.value = value;
    });
    // ...or arriving from another page via /book?treatment=Name.
    const fromUrl = new URLSearchParams(window.location.search).get('treatment');
    if (fromUrl && [...treatment.options].some((o) => o.value === fromUrl)) treatment.value = fromUrl;

    const validate = () => {
      const er: Record<string, string> = {};
      if (name.value.trim().length < 2) er.name = 'Please enter your name.';
      if (!/^[6-9]\d{9}$/.test(phone.value.replace(/\D/g, '').slice(-10))) er.phone = 'Enter a 10-digit mobile number.';
      if (!date.value) er.date = 'Choose a date.';
      else if (!slots.length) er.date = 'No slots left on this day — please pick another date.';
      if (date.value && slots.length && !slot.value) er.slot = 'Choose a time.';
      Object.keys(inputs).forEach((k) => setError(k, er[k]));
      return Object.keys(er).length === 0;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!validate()) return;
      const message = bookingMessage({
        name: name.value,
        phone: phone.value,
        treatment: treatment.value,
        doctor: doctor.value,
        date: date.value,
        slot: slot.value,
        firstVisit: firstVisit.checked,
        note: note.value,
      });
      window.open(waLink(message), '_blank', 'noopener');
      if (sent) sent.hidden = false;
    });
  }
</script>
