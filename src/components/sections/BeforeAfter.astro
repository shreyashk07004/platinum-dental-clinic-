---
// "Real results": before/after comparison cards. Drag (or use arrow keys on)
// the slider to reveal the "before" picture over the "after" picture.
// Pictures and labels live in src/data/beforeAfter.js.
import { ChevronsLeftRight } from '@lucide/astro';
import { cases } from '../../data/beforeAfter';
---

<section id="results" aria-labelledby="results-title" class="py-20 md:py-28">
  <div class="wrap">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="kicker justify-center">Real results</p>
      <h2 id="results-title" class="h-section">Before &amp; after</h2>
      <p class="mt-4 text-[17px]">Slide across each picture to see the change.</p>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        cases.map((c) => (
          <figure class="reveal">
            <div class="ba relative aspect-[4/3] select-none overflow-hidden rounded-md border border-line bg-enamel" style="--pos: 50%" data-ba>
              <img src={c.after} alt={c.afterAlt} class="absolute inset-0 h-full w-full object-cover" loading="lazy" width="800" height="600" draggable="false" />
              <img src={c.before} alt={c.beforeAlt} class="ba-before absolute inset-0 h-full w-full object-cover" loading="lazy" width="800" height="600" draggable="false" />

              <span class="pointer-events-none absolute left-3 top-3 rounded bg-ink/80 px-2 py-1 font-display text-[12px] font-semibold uppercase tracking-[0.12em] text-white">Before</span>
              <span class="pointer-events-none absolute right-3 top-3 rounded bg-white/90 px-2 py-1 font-display text-[12px] font-semibold uppercase tracking-[0.12em] text-ink">After</span>

              <div class="ba-line pointer-events-none absolute inset-y-0 w-0.5 -translate-x-1/2 bg-white" aria-hidden="true">
                <span class="absolute left-1/2 top-1/2 grid h-10 w-10 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-white bg-action text-white shadow-[0_4px_14px_rgba(13,30,56,0.35)]">
                  <ChevronsLeftRight class="h-5 w-5" />
                </span>
              </div>

              <input
                type="range"
                min="0"
                max="100"
                value="50"
                step="1"
                class="ba-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0"
                aria-label={`${c.label}: drag to compare before and after`}
                data-ba-range
              />
            </div>
            <figcaption class="mt-4">
              <h3 class="text-[19px] font-bold">{c.label}</h3>
              <p class="mt-1 text-[15px] leading-snug">{c.note}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>

  </div>
</section>

<style>
  .ba-before { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba-line { left: var(--pos); }
  /* Let vertical page scroll pass through on touch screens */
  .ba-range { touch-action: pan-y; -webkit-appearance: none; appearance: none; margin: 0; background: transparent; }
  /* A thin invisible thumb so the divider sits exactly where you press */
  .ba-range::-webkit-slider-thumb { -webkit-appearance: none; width: 2px; height: 600px; }
  .ba-range::-moz-range-thumb { width: 2px; height: 600px; border: 0; }
  .ba:has(.ba-range:focus-visible) { outline: 2px solid #1a9bd7; outline-offset: 3px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((box) => {
    const range = box.querySelector<HTMLInputElement>('[data-ba-range]');
    if (!range) return;
    const set = () => box.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', set);
    set();
  });
</script>
