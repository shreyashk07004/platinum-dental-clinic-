---
import { Plus, Minus } from '@lucide/astro';
import { faqs as generalFaqs } from '../../data/faqs';

// Reusable FAQ accordion. Each page passes its own questions so no two pages
// repeat the same set (duplicate FAQs across pages are ignored by Google).
// Also emits FAQPage structured data for the questions shown.
const {
  items = generalFaqs,
  kicker = 'Questions',
  title = 'What patients usually ask us first.',
  intro,
  tone = 'white', // 'white' | 'enamel'
} = Astro.props;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section id="faq" aria-labelledby="faq-title" class:list={['section-y', tone === 'enamel' && 'bg-enamel']}>
  <div class="wrap grid gap-8 sm:gap-10 lg:grid-cols-12">
    <div class="reveal lg:col-span-4">
      <p class="kicker">{kicker}</p>
      <h2 id="faq-title" class="h-section">{title}</h2>
      {intro && <p class="mt-5 max-w-sm text-[15.5px] text-slate-soft">{intro}</p>}
    </div>
    <ul class="reveal border-t border-ink lg:col-span-8" data-faq>
      {
        items.map((f, i) => (
          <li class="border-b border-line">
            <h3 class="text-[16.5px] sm:text-[18px]">
              <button
                type="button"
                data-faq-toggle
                aria-expanded={String(i === 0)}
                aria-controls={`faq-${i}`}
                class="flex min-h-[56px] w-full items-center justify-between gap-4 py-4 text-left font-display font-bold leading-snug text-ink hover:text-action sm:gap-6 sm:py-5"
              >
                {f.q}
                <span data-icon-minus class:list={['shrink-0', i === 0 ? 'block' : 'hidden']}><Minus class="h-5 w-5 text-clinic" /></span>
                <span data-icon-plus class:list={['shrink-0', i === 0 ? 'hidden' : 'block']}><Plus class="h-5 w-5 text-clinic" /></span>
              </button>
            </h3>
            <div id={`faq-${i}`} hidden={i !== 0} class="max-w-2xl pb-5 text-[15.5px] sm:pb-6 sm:text-[16px]">{f.a}</div>
          </li>
        ))
      }
    </ul>
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
</section>

<script>
  // Accordion: one answer open at a time (the first is open on load).
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-faq] [data-faq-toggle]');

  const setOpen = (btn: HTMLButtonElement, open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    const panel = document.getElementById(btn.getAttribute('aria-controls') || '');
    if (panel) panel.hidden = !open;
    const minus = btn.querySelector('[data-icon-minus]');
    const plus = btn.querySelector('[data-icon-plus]');
    minus?.classList.toggle('hidden', !open);
    minus?.classList.toggle('block', open);
    plus?.classList.toggle('hidden', open);
    plus?.classList.toggle('block', !open);
  };

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const wasOpen = btn.getAttribute('aria-expanded') === 'true';
      buttons.forEach((b) => setOpen(b, false));
      if (!wasOpen) setOpen(btn, true);
    })
  );
</script>
