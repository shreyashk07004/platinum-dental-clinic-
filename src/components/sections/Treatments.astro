---
import { Plus } from '@lucide/astro';
import { treatments, treatmentGroups } from '../../data/treatments';
import TreatmentDrawer from '../ui/TreatmentDrawer.astro';

---

<section id="treatments" aria-labelledby="treatments-title" class="section-y">
  <div class="wrap">
    <div class="reveal grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="kicker">Treatments</p>
        <h2 id="treatments-title" class="h-section">What we do and how long it takes.</h2>
      </div>
      <p class="text-[15.5px] text-slate-soft lg:col-span-4 lg:col-start-9">
        Every treatment starts with a check-up and a plan explained in plain words. Tap any treatment for details,
        or <a href="/book" class="font-semibold text-action hover:underline">book online</a>.
      </p>
    </div>

    <div class="mt-10 sm:mt-14 space-y-10 sm:space-y-14">
      {
        treatmentGroups.map((g, gi) => (
          <div class="reveal grid gap-3 sm:gap-4 lg:grid-cols-12">
            <div class="lg:col-span-3">
              <p class="font-display text-[13px] font-bold text-clinic-dark">0{gi + 1}</p>
              <h3 class="mt-1 text-[1.35rem] font-bold">{g.label}</h3>
            </div>
            <ul class="border-t border-ink lg:col-span-9">
              {treatments
                .filter((t) => t.group === g.id)
                .map((t) => (
                  <li class="border-b border-line">
                    <button
                      type="button"
                      data-drawer-open={t.id}
                      class="group grid w-full grid-cols-[1fr_auto] gap-x-4 gap-y-1 py-4 text-left sm:grid-cols-12 sm:items-baseline sm:gap-4 sm:py-5"
                      aria-haspopup="dialog"
                    >
                      <span class="font-display text-[17px] font-bold text-ink group-hover:text-action sm:col-span-4 sm:text-[18px]">{t.name}</span>
                      <span class="row-span-2 flex items-center justify-end self-center sm:order-last sm:col-span-1 sm:row-span-1 sm:self-auto">
                        <span class="grid h-8 w-8 place-items-center rounded-full bg-clinic-light sm:h-auto sm:w-auto sm:bg-transparent">
                          <Plus class="h-4 w-4 text-clinic transition-transform group-hover:rotate-90" />
                        </span>
                      </span>
                      <span class="text-[14.5px] leading-snug text-slate sm:col-span-7 sm:text-[15px]">{t.fixes}</span>
                    </button>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  {treatments.map((t) => <TreatmentDrawer treatment={t} />)}
</section>

<script>
  let current: HTMLElement | null = null;
  let returnFocus: HTMLElement | null = null;

  const close = () => {
    if (!current) return;
    current.hidden = true;
    current = null;
    document.body.style.overflow = '';
    // preventScroll so a "Book" click can scroll down to the form uninterrupted
    returnFocus?.focus({ preventScroll: true });
  };

  const open = (id: string, trigger: HTMLElement) => {
    const drawer = document.getElementById(`drawer-${id}`);
    if (!drawer) return;
    returnFocus = trigger;
    current = drawer;
    drawer.hidden = false;
    document.body.style.overflow = 'hidden';
    drawer.querySelector<HTMLElement>('[data-autofocus]')?.focus();
  };

  document.querySelectorAll<HTMLElement>('[data-drawer-open]').forEach((btn) =>
    btn.addEventListener('click', () => open(btn.dataset.drawerOpen || '', btn))
  );
  document.querySelectorAll('[data-drawer-close]').forEach((btn) => btn.addEventListener('click', close));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
</script>
