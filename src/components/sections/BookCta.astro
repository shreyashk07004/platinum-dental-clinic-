---
// Booking call-to-action box: text on the left, the three ways to book on the right.
import { CalendarCheck, Phone, ArrowRight } from '@lucide/astro';
import { site } from '../../data/site';
import { waLink, quickMessage } from '../../utils/whatsapp';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import ToothArch from '../motifs/ToothArch.astro';
---

<section aria-labelledby="cta-title" class="pb-20 pt-4 md:pb-28">
  <div class="wrap">
    <div class="reveal relative mx-auto max-w-[1000px] overflow-hidden rounded-md bg-ink px-6 py-10 text-white sm:px-10 md:py-12">
      <ToothArch class="pointer-events-none absolute -right-28 -top-10 w-[520px] opacity-[0.10]" stroke="#FFFFFF" strokeWidth={1} />

      <div class="relative grid gap-8 md:grid-cols-[1.35fr_1fr] md:items-center md:gap-12">
        <div>
          <h2 id="cta-title" class="font-display text-[1.85rem] font-bold leading-[1.15] text-white [text-wrap:balance] sm:text-[2.2rem]">
            Book your dental appointment now
          </h2>
          <p class="mt-4 text-[16px] leading-relaxed text-white/80">
            Tell us what’s troubling you and pick a time that fits your day. We confirm on WhatsApp, explain
            your options in plain words before we start.
          </p>
          <p class="mt-4 text-[14px] text-white/60">Open Monday to Saturday, and Sunday mornings · Nagala Park, Kolhapur</p>
        </div>

        <div class="flex flex-col gap-3">
          <a href="/book" class="btn-light group justify-between">
            <span class="inline-flex items-center gap-2"><CalendarCheck class="h-[18px] w-[18px]" /> Choose a time slot</span>
            <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
          </a>
          <a href={waLink(quickMessage())} target="_blank" rel="noopener noreferrer" class="btn justify-start bg-[#1B8F4A] text-white hover:bg-[#167A3F]">
            <WhatsAppIcon class="h-[18px] w-[18px]" /> Message us on WhatsApp
          </a>
          <a href={`tel:${site.phoneRaw}`} class="btn justify-start border border-white/30 text-white hover:border-white hover:bg-white hover:text-ink">
            <Phone class="h-[18px] w-[18px]" /> Call {site.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
