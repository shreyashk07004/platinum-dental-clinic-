---
import { site, nav } from '../../data/site';
import { clinicHours } from '../../data/hours';
import { waLink, quickMessage } from '../../utils/whatsapp';
import Logo from '../ui/Logo.astro';
import ToothArch from '../motifs/ToothArch.astro';
---

<footer class="relative overflow-hidden bg-ink-deep text-white/75">
  <ToothArch class="pointer-events-none absolute -bottom-16 left-1/2 w-[640px] -translate-x-1/2 opacity-[0.07]" stroke="#FFFFFF" strokeWidth={1} />
  <div class="wrap relative grid gap-10 py-12 text-[14.5px] sm:py-16 md:grid-cols-12">
    <div class="md:col-span-4">
      <Logo tone="light" />
      <p class="mt-4 max-w-xs">{site.tagline}. Since {site.established}.</p>
      <a href={waLink(quickMessage())} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block py-2 font-semibold text-white underline decoration-clinic underline-offset-4">
        Message us on WhatsApp
      </a>
    </div>
    <nav aria-label="Footer" class="md:col-span-3">
      <p class="font-display text-[13px] font-semibold uppercase tracking-[0.14em] text-white">Pages</p>
      <ul class="mt-2 grid grid-cols-2 gap-x-6 md:mt-3 md:block md:space-y-2">
        {nav.map((n) => <li><a href={n.href} class="block py-2 hover:text-white md:inline md:py-0">{n.label}</a></li>)}
        <li><a href="/book" class="block py-2 hover:text-white md:inline md:py-0">Book appointment</a></li>
      </ul>
    </nav>
    <div class="md:col-span-5">
      <p class="font-display text-[13px] font-semibold uppercase tracking-[0.14em] text-white">Visit</p>
      <p class="mt-3">{site.addressLines.join(', ')}</p>
      <p class="mt-1"><a href={`tel:${site.phoneRaw}`} class="inline-block py-2 text-white hover:underline md:py-0">{site.phoneDisplay}</a></p>
      <dl class="mt-4 space-y-1">
        {
          clinicHours.summary.map((r) => (
            <div class="flex flex-wrap gap-x-3">
              <dt class="w-[8.5rem] shrink-0 sm:w-52">{r.days}{r.note && ` · ${r.note}`}</dt>
              <dd class="text-white">{r.time}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
  <div class="relative border-t border-white/10">
    <div class="wrap flex flex-col gap-2 py-5 text-[13px] text-white/60 sm:flex-row sm:justify-between">
      <p>© <span data-year>{new Date().getFullYear()}</span> {site.name}. Information on this site is general and not a substitute for a check-up.</p>
          </div>
  </div>
</footer>

<script>
  // Keep the copyright year current even if the site isn't rebuilt.
  document.querySelectorAll('[data-year]').forEach((el) => (el.textContent = String(new Date().getFullYear())));
</script>
