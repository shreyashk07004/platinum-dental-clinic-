---
import { ArrowRight, CircleExclamationPoint } from '@lucide/astro';
import { services as symptoms } from '../../data/services';
import { waLink, symptomMessage } from '../../utils/whatsapp';
import ToothArch from '../motifs/ToothArch.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';

const activeId = symptoms[0].id;
const tabOn = 'border-white bg-white text-ink';
const tabOff = 'border-white/35 text-white hover:border-white';
---

<section aria-labelledby="finder-title" class="relative overflow-hidden bg-clinic-dark text-white">
  <ToothArch class="pointer-events-none absolute -right-24 -top-10 w-[560px] opacity-25" stroke="#FFFFFF" strokeWidth={1} />
  <div class="wrap relative grid gap-12 py-20 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="mb-3 flex items-center gap-3 font-display text-[13px] font-semibold uppercase tracking-[0.14em] text-white/80">
        <span class="block h-px w-8 bg-white/60"></span> Not sure what you need?
      </p>
      <h2 id="finder-title" class="text-[2rem] font-bold leading-[1.1] text-white sm:text-[2.6rem]">
        Tell us what’s bothering you.
      </h2>
      <p class="mt-5 max-w-md text-[17px] text-white/85">
        Pick the closest problem. We’ll tell you what it usually means and what we’d check — then you can ask
        us directly on WhatsApp.
      </p>
      <div class="mt-8 flex flex-wrap gap-2" role="tablist" aria-label="Dental problems" data-finder-tabs data-on={tabOn} data-off={tabOff}>
        {
          symptoms.map((x) => (
            <button
              type="button"
              role="tab"
              aria-selected={String(x.id === activeId)}
              aria-controls="finder-panel"
              data-symptom={x.id}
              class:list={[
                'rounded border px-3.5 py-2 font-display text-[14.5px] font-semibold transition-colors',
                x.id === activeId ? tabOn : tabOff,
              ]}
            >
              {x.label}
            </button>
          ))
        }
      </div>
    </div>

    <div id="finder-panel" role="tabpanel" aria-live="polite" class="lg:col-span-6 lg:col-start-7">
      {
        symptoms.map((s) => (
          <div data-symptom-panel={s.id} hidden={s.id !== activeId}>
            <div class="rounded-md bg-white p-7 text-slate md:p-9">
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-[1.6rem] font-bold leading-tight">{s.label}</h3>
                {s.urgent && (
                  <span class="inline-flex shrink-0 items-center gap-1.5 rounded-sm bg-[#FCEDEA] px-2 py-1 text-[12px] font-semibold text-[#A3392B]">
                    <CircleExclamationPoint class="h-3.5 w-3.5" /> Don’t wait on this
                  </span>
                )}
              </div>
              <p class="mt-3 font-display text-[17px] font-semibold text-ink">{s.likely}</p>
              <p class="mt-2 text-[15.5px]">{s.advice}</p>

              <div class="mt-6 border-y border-line">
                {s.href ? (
                  <a
                    href={s.href}
                    class="group flex w-full items-center justify-between py-3 text-left font-display text-[16px] font-semibold text-ink hover:text-action"
                  >
                    Book online
                    <span class="flex items-center gap-1 text-[13px] text-slate-soft group-hover:text-action">
                      Choose a slot <ArrowRight class="h-4 w-4" />
                    </span>
                  </a>
                ) : (
                  <button
                    type="button"
                    data-book={s.label}
                    class="group flex w-full items-center justify-between py-3 text-left font-display text-[16px] font-semibold text-ink hover:text-action"
                  >
                    {s.label}
                    <span class="flex items-center gap-1 text-[13px] text-slate-soft group-hover:text-action">
                      Book <ArrowRight class="h-4 w-4" />
                    </span>
                  </button>
                )}
              </div>

              <a href={waLink(symptomMessage(s.label))} target="_blank" rel="noopener noreferrer" class="btn-primary mt-7 w-full sm:w-auto">
                <WhatsAppIcon class="h-[18px] w-[18px]" /> Ask the doctor on WhatsApp
              </a>
              <p class="mt-3 text-[12.5px] text-slate-soft">General guidance only — a check-up is the only way to know for sure.</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelector<HTMLElement>('[data-finder-tabs]');
  if (tabs) {
    const on = (tabs.dataset.on || '').split(' ');
    const off = (tabs.dataset.off || '').split(' ');
    const buttons = tabs.querySelectorAll<HTMLButtonElement>('[data-symptom]');
    const panels = document.querySelectorAll<HTMLElement>('[data-symptom-panel]');

    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const id = btn.dataset.symptom;
        buttons.forEach((b) => {
          const active = b === btn;
          b.setAttribute('aria-selected', String(active));
          b.classList.remove(...(active ? off : on));
          b.classList.add(...(active ? on : off));
        });
        panels.forEach((p) => (p.hidden = p.dataset.symptomPanel !== id));
      })
    );
  }
</script>
