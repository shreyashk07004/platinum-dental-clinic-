---
import { doctors } from '../../data/doctors';
---

<section id="doctors" aria-labelledby="doctors-title" class="bg-enamel section-y">
  <div class="wrap">
    <div class="reveal max-w-2xl">
      <p class="kicker">Your doctors</p>
      <h2 id="doctors-title" class="h-section">You’ll be treated by the same two people every time.</h2>
    </div>

    <div class="mt-10 sm:mt-14 space-y-14 sm:space-y-16">
      {
        doctors.map((d, i) => (
          <article class="reveal grid gap-6 sm:gap-8 md:grid-cols-12 md:gap-10" aria-labelledby={`dr-${d.id}`}>
            <div class:list={['md:col-span-5 lg:col-span-4', i % 2 ? 'md:order-2 md:col-start-8 lg:col-start-9' : '']}>
              <img
                src={d.image}
                alt={`Portrait of ${d.name}`}
                class="aspect-[4/3.4] w-full rounded-md object-cover sm:aspect-square md:aspect-[4/5]"
                style={{ objectPosition: d.imagePosition }}
                loading="lazy"
                width="800"
                height="1000"
              />
            </div>
            <div class:list={['md:col-span-7 lg:col-span-7', i % 2 ? 'md:order-1 md:col-start-1' : 'lg:col-start-6']}>
              <p class="font-display text-[14px] font-semibold text-clinic-dark">{d.role}</p>
              <h3 id={`dr-${d.id}`} class="mt-1 text-[1.75rem] font-bold leading-tight sm:text-[2rem]">{d.name}</h3>
              <p class="mt-1 text-[15px] text-slate-soft">{d.degrees} · {d.regNo}</p>
              <p class="mt-4 max-w-xl text-[16px] sm:mt-5 sm:text-[17px]">{d.bio}</p>

              <div class="mt-6 grid gap-6 sm:mt-7 sm:grid-cols-2 sm:gap-8">
                <div>
                  <p class="text-[12px] font-semibold uppercase tracking-[0.14em] text-slate-soft">Special interest</p>
                  <ul class="mt-2 space-y-1.5 text-[15.5px] text-ink">
                    {d.interests.map((x) => (
                      <li class="flex items-start gap-2.5"><span class="mt-[0.8em] h-px w-3 shrink-0 bg-clinic"></span>{x}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <p class="text-[12px] font-semibold uppercase tracking-[0.14em] text-slate-soft">Available</p>
                  <dl class="mt-2 divide-y divide-line border-y border-line text-[14.5px]">
                    {d.timings.map((t) => (
                      <div class="flex justify-between gap-3 py-2">
                        <dt class="text-slate">{t.days}</dt>
                        <dd class="whitespace-nowrap font-semibold tabular-nums text-ink">{t.time}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
