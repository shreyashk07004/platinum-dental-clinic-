---
import { Phone, Mail, CircleCheck } from '@lucide/astro';
import { site } from '../../data/site';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';

// General contact form for patients and anyone else (suppliers, job seekers,
// partners). On submit it opens WhatsApp with the message pre-written.
const errClass = 'mt-1 text-[13px] font-medium text-[#B23A2B]';
---

<section id="contact-form" aria-labelledby="contact-form-title" class="py-20 md:py-28">
  <div class="wrap grid gap-12 lg:grid-cols-12">
    <div class="reveal lg:col-span-4">
      <p class="kicker">Write to us</p>
      <h2 id="contact-form-title" class="h-section">Send us a message.</h2>
      <p class="mt-5 text-[16.5px]">
        Patients, suppliers, students looking for an internship, anyone. Fill this in and WhatsApp opens with
        your message already written. Just press send.
      </p>
      <ul class="mt-8 space-y-3 border-t border-line pt-6 text-[15px]">
        <li class="flex items-center gap-3">
          <Phone class="h-5 w-5 shrink-0 text-clinic-dark" />
          <a href={`tel:${site.phoneRaw}`} class="font-semibold text-ink hover:text-action">{site.phoneDisplay}</a>
        </li>
        <li class="flex items-center gap-3">
          <Mail class="h-5 w-5 shrink-0 text-clinic-dark" />
          <a href={`mailto:${site.email}`} class="hover:text-action">{site.email}</a>
        </li>
      </ul>
      <p class="mt-4 text-[14px] text-slate-soft">Want to book a visit? Use the <a href="/book" class="font-semibold text-action hover:underline">booking page</a> to pick a date and time.</p>
    </div>

    <form id="contact-form-el" novalidate class="reveal rounded-md border border-line bg-white p-6 md:p-9 lg:col-span-8">
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="c-name" class="label">Full name</label>
          <input id="c-name" name="name" class="field" autocomplete="name" aria-invalid="false" />
          <p id="c-name-err" class={errClass} hidden></p>
        </div>
        <div>
          <label for="c-phone" class="label">Mobile number</label>
          <input id="c-phone" name="phone" class="field" inputmode="tel" autocomplete="tel" placeholder="98xxxxxxxx" aria-invalid="false" />
          <p id="c-phone-err" class={errClass} hidden></p>
        </div>
        <div>
          <label for="c-email" class="label">Email <span class="font-normal text-slate-soft">(optional)</span></label>
          <input id="c-email" name="email" type="email" class="field" autocomplete="email" />
        </div>
        <div>
          <label for="c-topic" class="label">Subject</label>
          <input id="c-topic" name="topic" class="field" maxlength="100" aria-invalid="false" placeholder="e.g. Question about dental implants" />
          <p id="c-topic-err" class={errClass} hidden></p>
        </div>
        <div class="sm:col-span-2">
          <label for="c-message" class="label">Message</label>
          <textarea id="c-message" name="message" rows="5" class="field resize-y" aria-invalid="false" placeholder="Write your message here"></textarea>
          <p id="c-message-err" class={errClass} hidden></p>
        </div>
      </div>

      <div class="mt-7 flex flex-col gap-4 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-[13px] text-slate-soft">Your message goes only to the clinic’s WhatsApp. Nothing is stored on this website.</p>
        <button type="submit" class="btn-primary shrink-0">
          <WhatsAppIcon class="h-[18px] w-[18px]" /> Send on WhatsApp
        </button>
      </div>
      <div id="contact-sent" hidden>
        <p role="status" class="mt-5 flex items-start gap-2 rounded bg-clinic-light p-3.5 text-[14.5px] text-ink">
          <CircleCheck class="mt-0.5 h-5 w-5 shrink-0 text-action" />
          WhatsApp should have opened with your message. Just press send. If it didn’t open, call us on {site.phoneDisplay}.
        </p>
      </div>
    </form>
  </div>
</section>

<script>
  import { waLink, contactMessage } from '../../utils/whatsapp';

  const form = document.getElementById('contact-form-el') as HTMLFormElement | null;
  if (form) {
    const get = <T extends HTMLElement>(n: string) => form.elements.namedItem(n) as T;
    const name = get<HTMLInputElement>('name');
    const phone = get<HTMLInputElement>('phone');
    const email = get<HTMLInputElement>('email');
    const topic = get<HTMLInputElement>('topic');
    const message = get<HTMLTextAreaElement>('message');
    const sent = document.getElementById('contact-sent');
    const inputs: Record<string, HTMLInputElement | HTMLTextAreaElement> = { name, phone, topic, message };

    const setError = (k: string, msg?: string) => {
      const p = document.getElementById(`c-${k}-err`);
      const input = inputs[k];
      if (!p || !input) return;
      p.textContent = msg || '';
      p.hidden = !msg;
      input.setAttribute('aria-invalid', String(!!msg));
      if (msg) input.setAttribute('aria-describedby', `c-${k}-err`);
      else input.removeAttribute('aria-describedby');
    };
    Object.keys(inputs).forEach((k) => inputs[k].addEventListener('input', () => setError(k)));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const er: Record<string, string> = {};
      if (name.value.trim().length < 2) er.name = 'Please enter your name.';
      if (!/^[6-9]\d{9}$/.test(phone.value.replace(/\D/g, '').slice(-10))) er.phone = 'Enter a 10-digit mobile number.';
      if (topic.value.trim().length < 3) er.topic = 'Please add a short subject.';
      if (message.value.trim().length < 5) er.message = 'Please write a short message.';
      Object.keys(inputs).forEach((k) => setError(k, er[k]));
      if (Object.keys(er).length) return;

      const text = contactMessage({
        name: name.value,
        phone: phone.value,
        email: email.value,
        topic: topic.value.trim(),
        message: message.value,
      });
      window.open(waLink(text), '_blank', 'noopener');
      if (sent) sent.hidden = false;
    });
  }
</script>
