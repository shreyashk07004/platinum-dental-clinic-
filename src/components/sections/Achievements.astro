---
// Achievements: headline stats, awards grid and a milestones timeline.
// Content lives in src/data/achievements.js (sample placeholders for now).
import { Trophy, Award, Medal, ShieldCheck, GraduationCap, Star } from '@lucide/astro';
import { stats, awards, milestones } from '../../data/achievements';

const icons = { Trophy, Award, Medal, ShieldCheck, GraduationCap, Star };
---

<section id="achievements" aria-labelledby="achievements-title" class="py-20 md:py-28">
  <div class="wrap">
    <div class="reveal max-w-2xl">
      <p class="kicker">Our achievements</p>
      <h1 id="achievements-title" class="h-section">Recognition earned one smile at a time.</h1>
      <p class="mt-5 max-w-xl text-[17px]">
        Awards, certifications and milestones that reflect the care our patients receive every day.
      </p>
    </div>

    <dl class="reveal mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-md border border-line bg-line md:grid-cols-4">
      {
        stats.map((s) => (
          <div class="bg-white px-5 py-7 text-center">
            <dt class="order-2 mt-1 text-[14px] text-slate-soft">{s.label}</dt>
            <dd class="font-display text-[2.1rem] font-bold leading-none text-ink">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<section aria-labelledby="awards-title" class="bg-enamel py-20 md:py-28">
  <div class="wrap">
    <div class="reveal max-w-2xl">
      <p class="kicker">Awards &amp; certifications</p>
      <h2 id="awards-title" class="h-section">Awards and recognitions</h2>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        awards.map((a) => {
          const Icon = icons[a.icon] ?? Award;
          return (
            <li class="reveal award-card flex flex-col rounded-md border border-line bg-white p-6">
              <div class="flex items-center justify-between">
                <span class="flex h-11 w-11 items-center justify-center rounded-md bg-clinic-light">
                  <Icon class="h-6 w-6 text-clinic-dark" stroke-width={1.7} aria-hidden="true" />
                </span>
                <span class="font-display text-[14px] font-semibold text-slate-soft">{a.year}</span>
              </div>
              <h3 class="mt-5 text-[19px] font-bold leading-snug">{a.title}</h3>
              <p class="mt-1 text-[14px] font-semibold text-clinic-dark">{a.by}</p>
              <p class="mt-3 text-[15.5px] leading-snug">{a.text}</p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<section aria-labelledby="milestones-title" class="py-20 md:py-28">
  <div class="wrap">
    <div class="reveal max-w-2xl">
      <p class="kicker">Our journey</p>
      <h2 id="milestones-title" class="h-section">Milestones along the way</h2>
    </div>

    <ol class="relative mt-12 max-w-3xl border-l border-line pl-8">
      {
        milestones.map((m) => (
          <li class="reveal relative pb-10 last:pb-0">
            <span class="absolute -left-[38px] top-1.5 h-3 w-3 rounded-full border-2 border-white bg-clinic ring-1 ring-clinic" aria-hidden="true"></span>
            <p class="font-display text-[14px] font-semibold text-clinic-dark">{m.year}</p>
            <h3 class="mt-1 text-[19px] font-bold leading-snug">{m.title}</h3>
            <p class="mt-1.5 text-[15.5px] leading-snug">{m.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .award-card { transition: border-color 150ms ease, transform 150ms ease; }
  .award-card:hover { border-color: #1a9bd7; transform: translateY(-2px); }
  dl > div { display: flex; flex-direction: column; }
</style>
